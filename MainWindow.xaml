<Window x:Class="practic23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practic23"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="600" Background="DarkGray">
    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <!-- Сам элемент с красной рамкой -->
                <Border BorderBrush="Red" BorderThickness="2">
                    <AdornedElementPlaceholder/>
                </Border>
                <!-- Сообщение об ошибке -->
                <TextBlock Foreground="Red" FontSize="12"
           Text="{Binding [0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Регистрация" Grid.Column="0" Grid.Row="0" FontSize="40" FontWeight="Bold" Grid.ColumnSpan="2" Margin="10"/>

        <TextBlock Text="Имя: " Grid.Column="0" Grid.Row="1" />
        <TextBox Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="1" Margin="10"/>

        <TextBlock Text="Email: " Grid.Column="0" Grid.Row="2" />
        <TextBox Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="2" Margin="10"/>

        <TextBlock Text="Возраст:" Grid.Column="0" Grid.Row="3" />
        <TextBox Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="3" Margin="10"/>

        <CheckBox Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Margin="10" FontSize="15">Согласен с условиями</CheckBox>

        <Button Content="Зарегистрироваться" Height="30" Click="Reg_Click" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Margin="10"/>

    </Grid>
</Window>
